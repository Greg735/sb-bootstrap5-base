{
  "name": "storybook-bootstrap5",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "assets": "vite build --config vite.assets.config.mjs",
    "assets:watch": "vite build --config vite.assets.config.mjs --watch",
    "storybook": "storybook dev --no-open -p 6006 --host 0.0.0.0",
    "develop": "concurrently --raw --kill-others \"npm run assets:watch\" \"npm run storybook\"",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "Storybook",
    "Bootstrap5",
    "Twig"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/html-vite": "^10.6.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.19",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "bs5-lightbox": "^1.8.3",
    "concurrently": "^8.2.2",
    "cssnano": "^7.0.3",
    "drupal-twig-extensions": "file:./packages/drupal-twig-extensions",
    "glightbox": "^3.3.0",
    "leaflet": "^1.9.4",
    "masonry-layout": "^4.2.2",
    "playwright": "^1.61.1",
    "postcss": "^8.5.28",
    "sass": "^1.77.6",
    "scrollcue": "^2.0.0",
    "storybook": "^10.6.1",
    "terser": "^5.31.1",
    "tinyglobby": "^0.2.17",
    "twig": "^3.0.0",
    "vite": "^6.0.0",
    "vite-plugin-twig-drupal": "^1.7.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "drupal-twig-extensions": "$drupal-twig-extensions"
  }
}
