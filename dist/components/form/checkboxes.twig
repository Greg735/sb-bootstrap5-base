{#
/**
 * @file
 * Checkboxes group — same contract as Drupal core checkboxes.html.twig.
 *
 * Drupal wraps the group in fieldset.twig: add the "container-inline" class to
 * the element #attributes (it lands on the fieldset) to display options inline.
 *
 * Drupal usage (templates/form/checkboxes.html.twig):
 *   {% include "@components/form/checkboxes.twig" %}
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The rendered checkboxes.
 */
#}
<div{{ attributes.addClass('form-checkboxes') }}>{{ children }}</div>
