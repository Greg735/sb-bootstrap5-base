{#
/**
 * @file
 * Form element wrapper — same contract as Drupal core form-element.html.twig.
 *
 * Drupal usage (templates/form/form-element.html.twig):
 *   {% include "@components/form/form-element/form-element.twig" %}
 *
 * Available variables:
 * - attributes: HTML attributes for the containing element.
 * - errors: (optional) Any errors for this form element.
 * - prefix: (optional) The form element prefix (rendered as an input-group).
 * - suffix: (optional) The form element suffix (rendered as an input-group).
 * - required: The required marker, or empty if not required.
 * - type: The type of the element (textfield, checkbox, radio, select…).
 * - name: The name of the element.
 * - label: A rendered label element (see form-element-label.twig).
 * - label_display: before | after | invisible | attribute.
 * - description: (optional) Object with content and attributes.
 * - description_display: before | after | invisible.
 * - disabled: True if the element is disabled.
 * - title_display: Title display setting.
 * - children: The rendered element (see input.twig, select.twig…).
 */
#}
{% set is_check = type in ['checkbox', 'radio'] %}
{% set has_addon = not is_check and (prefix is not empty or suffix is not empty) %}
{%
  set classes = [
    'js-form-item',
    'form-item',
    'js-form-type-' ~ type|clean_class,
    'form-type-' ~ type|clean_class,
    'js-form-item-' ~ name|clean_class,
    'form-item-' ~ name|clean_class,
    title_display not in ['after', 'before'] ? 'form-no-label' : '',
    disabled == 'disabled' ? 'form-disabled' : '',
    errors ? 'form-item--error' : '',
    is_check ? 'form-check' : '',
  ]
%}
{%
  set description_classes = [
    'description',
    'form-text',
    description_display == 'invisible' ? 'visually-hidden' : '',
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {% if label_display in ['before', 'invisible'] %}
    {{ label }}
  {% endif %}
  {% if description_display == 'before' and description.content %}
    <div{{ description.attributes.addClass(description_classes) }}>
      {{ description.content }}
    </div>
  {% endif %}
  {% if has_addon %}
    <div class="input-group{{ errors ? ' has-validation' }}">
  {% elseif prefix is not empty %}
    <span class="field-prefix">{{ prefix }}</span>
  {% endif %}
  {% if has_addon and prefix is not empty %}
    <span class="input-group-text field-prefix">{{ prefix }}</span>
  {% endif %}
  {{ children }}
  {% if has_addon and suffix is not empty %}
    <span class="input-group-text field-suffix">{{ suffix }}</span>
  {% elseif suffix is not empty %}
    <span class="field-suffix">{{ suffix }}</span>
  {% endif %}
  {% if has_addon %}
    </div>
  {% endif %}
  {% if label_display == 'after' %}
    {{ label }}
  {% endif %}
  {% if errors %}
    <div class="form-item--error-message invalid-feedback d-block">
      {{ errors }}
    </div>
  {% endif %}
  {% if description_display in ['after', 'invisible'] and description.content %}
    <div{{ description.attributes.addClass(description_classes) }}>
      {{ description.content }}
    </div>
  {% endif %}
</div>
